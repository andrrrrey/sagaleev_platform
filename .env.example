# ─── App ───
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Цифровой отдел маркетинга"

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sagaleev?schema=public

# ─── Auth.js ───
AUTH_SECRET=change-me-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# ─── Payments ───
# yookassa | mock (mock only allowed in dev/test)
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ─── Kinescope ───
KINESCOPE_API_KEY=

# ─── S3-compatible storage ───
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Mail (SMTP, RF perimeter) ───
SMTP_URL=
MAIL_FROM="Цифровой отдел маркетинга <noreply@example.ru>"

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── LLM curator ───
ANTHROPIC_API_KEY=
CURATOR_ENABLED=true

# ─── Seed (dev/staging only) ───
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=change-me-admin
EDITOR_EMAIL=editor@example.ru
EDITOR_PASSWORD=change-me-editor

# ─── Observability ───
SENTRY_DSN=
